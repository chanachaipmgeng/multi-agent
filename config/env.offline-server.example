# EMAW — offline / air-gap server knobs (Precision 7920 class)
# Copy: cp config/env.offline-server.example .env
# Then set SECRET_* values and run: make secrets-dev
# Full runbook: docs/offline-airgap.md

# --- LLM (DECISION-15) — no OpenRouter ---
LLM_MODE=local
LOCAL_LLM_MODEL=qwen2.5-coder:14b
LOCAL_LLM_FALLBACK=qwen2.5-coder:7b
OLLAMA_CONTEXT_LENGTH=65536
INFERENCE_OLLAMA_PORT=11436
ADAPTER_DISPATCHER=hermes_api

# --- Required secrets (replace placeholders) ---
SECRET_HERMES_API_KEY=change-me-hermes-api-key
SECRET_MINIO_ROOT_PASSWORD=emaw-minio-dev-change-me
SECRET_MINIO_AGENT_SECRET=emaw-minio-agent-dev
MINIO_ROOT_USER=emaw
MINIO_ROOT_PASSWORD=emaw-minio-dev-change-me
MINIO_ACCESS_KEY=emaw
MINIO_BUCKET=emaw-artifacts

# Gateway / GitLab webhook still needed for local webhook-test; SaaS optional offline
SECRET_GITLAB_WEBHOOK_SECRET=change-me-gitlab-webhook
SECRET_GITLAB_TOKEN_READONLY=glpat-placeholder-readonly
SECRET_GITLAB_TOKEN_FRONTEND=glpat-placeholder-frontend
SECRET_GITLAB_TOKEN_BACKEND=glpat-placeholder-backend
SECRET_GITLAB_TOKEN_CI=glpat-placeholder-ci
SECRET_GITLAB_TOKEN_QA=glpat-placeholder-qa

# Leave cloud LLM / tunnel empty for air-gap
# SECRET_LLM_KEY_COORDINATOR=
# SECRET_TUNNEL_TOKEN=
# SECRET_TELEGRAM_TOKEN=

# SocratiCode loopback ports
SOCRATICODE_OLLAMA_PORT=11435
SOCRATICODE_QDRANT_HTTP_PORT=16333
SOCRATICODE_QDRANT_GRPC_PORT=16334

# Observability (default Grafana :3000; remap if another stack owns the port)
PROMETHEUS_RETENTION=90d
# GRAFANA_PORT=3030

# Optional: local MinIO tag after docker load when Hub denies minio/minio
# MINIO_IMAGE=minio/minio:emaw-offline
