# Enterprise Multi-Agent Workspace — environment template
#
# 1. cp .env.example .env            (never commit .env — it is gitignored)
# 2. fill in values
# 3. make secrets-encrypt            → .env.enc (SOPS + age, safe to commit)
# 4. make secrets-decrypt            → ./secrets/<name> files consumed by docker compose
# 5. scripts/hermes-seed-env.sh      → hermes-data/<agent>/.env for compose agents profile
#
# Every value below is a PLACEHOLDER. Real tokens must only ever live in .env (local) or .env.enc.

# ---------------------------------------------------------------- platform
TZ=Asia/Bangkok
# Pinned digests (D4.6 / E12) — refresh with scripts/pin-digests.sh --apply
HERMES_IMAGE=nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db
REDIS_IMAGE=redis:7-alpine@sha256:8b81dd37ff027bec4e516d41acfbe9fe2460070dc6d4a4570a2ac5b9d59df065
POSTGRES_IMAGE=postgres:16-alpine@sha256:16bc17c64a573ef34162af9298258d1aec548232985b33ed7b1eac33ba35c229
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
OLLAMA_IMAGE=ollama/ollama@sha256:8262851b2846b87c649eddf3e76beb270c52f4d1bc94559f47efde16b0841551
QDRANT_IMAGE=qdrant/qdrant:v1.17.0@sha256:f1c7272cdac52b38c1a0e89313922d940ba50afd90d593a1605dbbc214e66ffb
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
LOKI_IMAGE=grafana/loki:3.3.2@sha256:8af2de1abbdd7aa92b27c9bcc96f0f4140c9096b507c77921ffddf1c6ad6c48f
TEMPO_IMAGE=grafana/tempo:2.6.1@sha256:ef4384fce6e8ad22b95b243d8fc165628cda655376fd50e7850536ad89d71d50
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.114.0@sha256:37fa87091cfaaec7234a27e4e395a40c31c2bfaea97a349a4afef6d9e9681197
PROMTAIL_IMAGE=grafana/promtail:3.3.2@sha256:cb4990801ec58975c5e231057c2bcf204c85fac428eec65ad66e0016c64b9608
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1@sha256:2659f4c2ebb718e7695cb9b25ffa7d6be64db013daba13e05c875451cf51b0d3
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0@sha256:e13b6ed5cb929eeaee733479dce55e10eb3bc2e9c4586c705a4e8da41e5eacf5
GRAFANA_IMAGE=grafana/grafana:11.3.1@sha256:fa801ab6e1ae035135309580891e09f7eb94d1abdbd2106bdc288030b028158c
HERMES_LOG_LEVEL=info
GATEWAY_LOG_LEVEL=info
GATEWAY_PORT=8700
REDIS_PORT=6379
POSTGRES_PORT=5432
HERMES_DASHBOARD_PORT=9119
HERMES_API_PORT=8642
HERMES_BACKEND_API_PORT=8643
# Observability (D4.1) — loopback only; make up-observability
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
# Operator Console (DECISION-20) — make up-console → http://127.0.0.1:8088
# LAN hybrid: CONSOLE_BIND=0.0.0.0 + make up-lan (also Grafana + Hermes dashboard on that bind;
# MinIO/Prometheus stay loopback — use SSH -L from a laptop).
CONSOLE_PORT=8088
# CONSOLE_BIND=0.0.0.0
CLOUDFLARED_METRICS_PORT=2000
# Adapter /metrics on host (container still binds :9100; Prometheus scrapes in-network)
ROUTER_METRICS_PORT=9101
ADAPTER_FE_METRICS_PORT=9102
ADAPTER_BE_METRICS_PORT=9103
ADAPTER_REVIEWER_METRICS_PORT=9104
ADAPTER_QA_METRICS_PORT=9105
ADAPTER_DEVOPS_METRICS_PORT=9106
# Optional cost estimate for llm_cost_usd_total (USD per 1k tokens). Default 0 = no invented price.
LLM_USD_PER_1K_TOKENS=0
GRAFANA_ADMIN_USER=emaw
GRAFANA_ADMIN_PASSWORD=emaw-grafana-dev
# Ops Telegram chat for Alertmanager (numeric id); empty = UI-only alerts
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- secrets
# Each SECRET_* line becomes ./secrets/<lowercase name without prefix> via make secrets-decrypt.

# Postgres password for the `emaw` user
SECRET_PG_PASSWORD=change-me-postgres-password

# GitLab → Webhook Gateway shared secret (Settings > Webhooks > Secret token). Rotate every 180 days.
SECRET_GITLAB_WEBHOOK_SECRET=change-me-webhook-secret

# GitHub → Webhook Gateway HMAC secret (X-Hub-Signature-256). Empty = /webhook/github returns 503; GitLab unaffected.
SECRET_GITHUB_WEBHOOK_SECRET=

# Cloudflare Named Tunnel connector token (cloudflared tunnel token <name>). Empty until DECISION-5.
SECRET_TUNNEL_TOKEN=

# Telegram bot token from @BotFather — coordinator only
SECRET_TELEGRAM_TOKEN=000000000:replace-with-botfather-token

# Bearer token for Hermes API server (:8642) — used by queue-adapter DISPATCHER=hermes_api
SECRET_HERMES_API_KEY=change-me-hermes-api-key

# Coordinator dashboard basic auth (:9119) — DECISION-18; seeded into hermes-data/coordinator/.env
SECRET_DASHBOARD_PASSWORD=change-me-dashboard-password
# Optional HMAC session secret (defaults to hermes_api_key if empty)
SECRET_DASHBOARD_SESSION_SECRET=

# LLM API keys — one per agent so cost and revocation are per role (design §6.3)
# Hermes reads these as OPENROUTER_API_KEY inside each profile .env (scripts/hermes-seed-env.sh)
SECRET_LLM_KEY_COORDINATOR=sk-placeholder-coordinator
SECRET_LLM_KEY_DEV_FRONTEND=sk-placeholder-dev-frontend
SECRET_LLM_KEY_DEV_BACKEND=sk-placeholder-dev-backend
SECRET_LLM_KEY_REVIEWER=sk-placeholder-reviewer
SECRET_LLM_KEY_DEVOPS=sk-placeholder-devops
SECRET_LLM_KEY_QA=sk-placeholder-qa

# SocratiCode (reviewer, Phase 2 — DECISION-6 local AGPL)
# SECRET_SOCRATICODE_KEY is unused in local mode (no API key). Keep empty or omit.
SECRET_SOCRATICODE_KEY=
# Host loopback ports when profile `socraticode` is up (compose maps → :11434 / :6333)
SOCRATICODE_OLLAMA_PORT=11435
SOCRATICODE_QDRANT_HTTP_PORT=16333
SOCRATICODE_QDRANT_GRPC_PORT=16334

# Local-free LLM mode (DECISION-15) — make up-local-free / up-offline
# cloud = OpenRouter keys in SECRET_LLM_KEY_* (default)
# local = all 6 agents → shared inference-ollama (no OpenRouter needed)
LLM_MODE=cloud
# Dev default 7b; on dual RTX 5000 (16GB×2) air-gap hosts prefer 14b — see docs/offline-airgap.md
LOCAL_LLM_MODEL=qwen2.5-coder:7b
# Optional fallback in config.local-free.yaml (defaults to LOCAL_LLM_MODEL)
# LOCAL_LLM_FALLBACK=qwen2.5-coder:7b
# Observability retention (DECISION-9 defaults; legal may override after D4.8)
PROMETHEUS_RETENTION=90d
# Loki retention is set in observability/loki-config.yaml (720h = 30d)
INFERENCE_OLLAMA_PORT=11436
# Hermes ≥0.21 needs ≥64K context (default Ollama window is 32K)
OLLAMA_CONTEXT_LENGTH=65536
# Air-gap: docs/offline-airgap.md + config/env.offline-server.example
# make preflight-offline → offline-acceptance → pack-offline → load-offline → up-offline

# MinIO artifact store (D3.7)
MINIO_ROOT_USER=emaw
MINIO_ROOT_PASSWORD=emaw-minio-dev-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=emaw
MINIO_BUCKET=emaw-artifacts
SECRET_MINIO_AGENT_SECRET=emaw-minio-agent-dev
SECRET_MINIO_ROOT_PASSWORD=emaw-minio-dev-change-me

# GitLab Project Access Tokens — scope read_api (+ write_repository for writers), 90-day rotation
SECRET_GITLAB_TOKEN_READONLY=glpat-placeholder-readonly
SECRET_GITLAB_TOKEN_FRONTEND=glpat-placeholder-frontend
SECRET_GITLAB_TOKEN_BACKEND=glpat-placeholder-backend
SECRET_GITLAB_TOKEN_CI=glpat-placeholder-ci
SECRET_GITLAB_TOKEN_QA=glpat-placeholder-qa

# GitHub fine-grained / classic PATs (optional) — seeded as GITHUB_TOKEN + GH_TOKEN for agents
SECRET_GITHUB_TOKEN_READONLY=
SECRET_GITHUB_TOKEN_FRONTEND=
SECRET_GITHUB_TOKEN_BACKEND=
SECRET_GITHUB_TOKEN_CI=
SECRET_GITHUB_TOKEN_QA=

# --------------------------------------------------------- non-secret config
GITLAB_BASE_URL=https://gitlab.com
GITHUB_BASE_URL=https://api.github.com
# Telegram user ids allowed to talk to the coordinator (comma separated) — see config/rbac.example.yaml
TELEGRAM_ALLOWED_USERS=987654321
# Chat id for queue-adapter notifications (Phase 1; leave empty to disable)
TELEGRAM_CHAT_ID=
# Public hostname of the Named Tunnel (DECISION-5), used by make tunnel-setup / tunnel-status
WEBHOOK_PUBLIC_URL=https://webhook.example.com

# queue-adapter → Hermes dispatch:
#   dryrun     — write prompts to outbox (default, no Hermes needed)
#   hermes_api — POST /v1/runs on Hermes API server (preferred, DECISION-1)
#   hermes_cli — hermes -p {agent} chat --oneshot -Q --query-file {prompt_file} -s {skill}
#   http       — legacy shim POST {task,prompt}
# Role adapters default to dryrun (platform-only). local-free / prod force hermes_api.
# Prefer hermes_api once agents are up (dryrun only for outbox debugging).
# make restart-adapters / up-local-free / up-cloud force hermes_api when needed.
ADAPTER_DISPATCHER=hermes_api
ADAPTER_LOG_LEVEL=info
HERMES_API_URL=http://dev-backend:8642
HERMES_HTTP_URL=
HERMES_CLI_TEMPLATE=hermes -p {agent} chat --oneshot -Q --query-file {prompt_file} -s {skill}
