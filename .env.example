# Enterprise Multi-Agent Workspace — environment template
#
# 1. cp .env.example .env            (never commit .env — it is gitignored)
# 2. fill in values
# 3. make secrets-encrypt            → .env.enc (SOPS + age, safe to commit)
# 4. make secrets-decrypt            → ./secrets/<name> files consumed by docker compose
#
# Every value below is a PLACEHOLDER. Real tokens must only ever live in .env (local) or .env.enc.

# ---------------------------------------------------------------- platform
TZ=Asia/Bangkok
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_LOG_LEVEL=info
GATEWAY_LOG_LEVEL=info
GATEWAY_PORT=8700
REDIS_PORT=6379
POSTGRES_PORT=5432
HERMES_DASHBOARD_PORT=9119

# ---------------------------------------------------------------- secrets
# Each SECRET_* line becomes ./secrets/<lowercase name without prefix> via make secrets-decrypt.

# Postgres password for the `emaw` user
SECRET_PG_PASSWORD=change-me-postgres-password

# GitLab → Webhook Gateway shared secret (Settings > Webhooks > Secret token). Rotate every 180 days.
SECRET_GITLAB_WEBHOOK_SECRET=change-me-webhook-secret

# Cloudflare Named Tunnel connector token (cloudflared tunnel token <name>). Empty until DECISION-5.
SECRET_TUNNEL_TOKEN=

# Telegram bot token from @BotFather — coordinator only
SECRET_TELEGRAM_TOKEN=000000000:replace-with-botfather-token

# LLM API keys — one per agent so cost and revocation are per role (design §6.3)
SECRET_LLM_KEY_COORDINATOR=sk-placeholder-coordinator
SECRET_LLM_KEY_DEV_FRONTEND=sk-placeholder-dev-frontend
SECRET_LLM_KEY_DEV_BACKEND=sk-placeholder-dev-backend
SECRET_LLM_KEY_REVIEWER=sk-placeholder-reviewer
SECRET_LLM_KEY_DEVOPS=sk-placeholder-devops
SECRET_LLM_KEY_QA=sk-placeholder-qa

# SocratiCode (reviewer, Phase 2)
SECRET_SOCRATICODE_KEY=

# GitLab Project Access Tokens — scope read_api (+ write_repository for writers), 90-day rotation
SECRET_GITLAB_TOKEN_READONLY=glpat-placeholder-readonly
SECRET_GITLAB_TOKEN_FRONTEND=glpat-placeholder-frontend
SECRET_GITLAB_TOKEN_BACKEND=glpat-placeholder-backend
SECRET_GITLAB_TOKEN_CI=glpat-placeholder-ci
SECRET_GITLAB_TOKEN_QA=glpat-placeholder-qa

# --------------------------------------------------------- non-secret config
GITLAB_BASE_URL=https://gitlab.com
# Telegram user ids allowed to talk to the coordinator (comma separated) — see config/rbac.example.yaml
TELEGRAM_ALLOWED_USERS=987654321
# Chat id for queue-adapter notifications (Phase 1; leave empty to disable)
TELEGRAM_CHAT_ID=
# Public hostname of the Named Tunnel (DECISION-5), used by make tunnel-setup / tunnel-status
WEBHOOK_PUBLIC_URL=https://webhook.example.com

# queue-adapter → Hermes dispatch: dryrun (write prompts to outbox) | http | hermes_cli
ADAPTER_DISPATCHER=dryrun
ADAPTER_LOG_LEVEL=info
# when ADAPTER_DISPATCHER=http — endpoint that accepts {"task":…, "prompt":…}
HERMES_HTTP_URL=
