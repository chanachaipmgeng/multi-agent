# --- secrets (never commit plaintext) ---------------------------------------
.env
.env.*
!.env.example
secrets/*
!secrets/README.md
!secrets/.gitkeep
*.age
age.key
*.pem
*.key
cloudflared/*.json
cloudflared/config.yml

# --- hermes runtime data (memory/sessions stay on the host) -----------------
hermes-data/*/memory/*
!hermes-data/*/memory/.gitkeep
# skills/ is the source of truth; hermes-data/*/skills is generated by make skills-sync
hermes-data/*/skills/*
!hermes-data/*/skills/.gitkeep
hermes-data/coordinator/rbac.yaml
hermes-data/*/sessions/
hermes-data/*/cache/
hermes-data/*/*.db
hermes-data/*/*.sqlite3

# --- workspace: project clones live outside git ------------------------------
workspace/*
!workspace/README.md
!workspace/_templates/
!workspace/_templates/**
!workspace/.worktrees/
workspace/.worktrees/*
!workspace/.worktrees/.gitkeep

# --- python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- misc --------------------------------------------------------------------
*.log
.DS_Store
node_modules/
